{
    "name": "mozzler/yii2-rbac",
    "description": "mozzler RBAC - Note that this Collection overrides target yiisoft/yii2-mongodb 3.x and Yii 2.0 (with PHP 8 compatible signatures, but doesn't work with yii2-mongodb 2.x)",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Were",
            "email": "chris@mozzler.com.au"
        },
        {
            "name": "Michael Kubler",
            "email": "michael+mozzler@greyphoenix.biz"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "yiisoft/yii2": "^2.0.45",
        "yiisoft/yii2-mongodb": "^3.0"
    },
    "conflict": {
        "yiisoft/yii2-mongodb": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "mozzler\\rbac\\": ""
        }
    }
}
